# Copier en .env.local pour le développement ; en production, saisir ces
# variables dans le panneau Render.
PORT=4500

# Vide = fichier .data/db.json (développement uniquement)
MONGODB_URI=
MONGODB_DB=sweettools

# 32+ caractères aléatoires
AUTH_SECRET=

# Domaines de la boutique, séparés par des virgules
ALLOWED_ORIGINS=http://localhost:3300,http://localhost:4330

# Compte admin créé par `npm run seed`
ADMIN_EMAIL=admin@sweettools.ma
ADMIN_PASSWORD=

# cloudinary://<api_key>:<api_secret>@<cloud_name> — vide = photos dans ./uploads
CLOUDINARY_URL=
CLOUDINARY_FOLDER=sweettools/produits

# URL publique de l'API (liens des photos stockées localement)
PUBLIC_URL=http://localhost:4500
